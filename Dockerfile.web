# Web image: the Angular PWA baked into Caddy. Build context = repository root.
#   docker build -f Dockerfile.web -t ims-web .
# The production stack mounts deploy/Caddyfile over /etc/caddy/Caddyfile; this image only carries the files in /srv/ims-web.
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build:prod

FROM caddy:2-alpine AS runtime
COPY --from=build /web/dist/main/browser /srv/ims-web
