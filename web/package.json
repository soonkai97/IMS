{
  "name": "ims-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "nx": "nx",
    "dev": "nx serve main --port=4200",
    "build": "nx build main --configuration=development",
    "build:prod": "nx build main --configuration=production",
    "serve:prod": "node scripts/serve-dist.mjs",
    "test": "nx run-many -t test --passWithNoTests",
    "coverage": "nx run-many -t test --coverage --passWithNoTests",
    "lint": "nx run-many -t lint && npm run lint:styles",
    "lint:styles": "stylelint \"{apps,libs}/**/*.scss\"",
    "format": "prettier --write \"{apps,libs,tools,scripts,docs}/**/*.{ts,html,scss,json,mjs,md}\"",
    "format:check": "prettier --check \"{apps,libs,tools,scripts,docs}/**/*.{ts,html,scss,json,mjs,md}\"",
    "api:generate": "node scripts/fetch-openapi.mjs && nswag run nswag.json",
    "contrast": "node scripts/check-contrast.mjs && node --test scripts/check-contrast.test.mjs",
    "dep-graph": "nx graph"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.7",
    "@angular-devkit/schematics": "^22.2.7",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@ngneat/spectator": "^22.1.0",
    "@nx/angular": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "^22.2.7",
    "@swc-node/register": "^1.10.0",
    "@swc/core": "^1.16.22",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.3",
    "lint-staged": "^17.6.0",
    "nswag": "^14.8.0",
    "nx": "24.0.6",
    "prettier": "~3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "undici": "^7.30.2",
    "minimatch": "^11.0.1",
    "sprintf-js": "^1.1.3",
    "vite": "^8.3.3"
  },
  "lint-staged": {
    "*.{ts,html,json,mjs,md}": "prettier --write",
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  }
}
