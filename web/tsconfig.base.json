{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "target": "es2022",
    "module": "esnext",
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "paths": {
      "@ims/api": ["./libs/shared/api/src/index.ts"],
      "@ims/assets": ["./libs/shared/assets/src/index.ts"],
      "@ims/containers/administration": ["./libs/containers/administration/src/index.ts"],
      "@ims/containers/approvals": ["./libs/containers/approvals/src/index.ts"],
      "@ims/containers/audit": ["./libs/containers/audit/src/index.ts"],
      "@ims/containers/authentication": ["./libs/containers/authentication/src/index.ts"],
      "@ims/containers/catalog": ["./libs/containers/catalog/src/index.ts"],
      "@ims/containers/catalog-shared": ["./libs/containers/catalog-shared/src/index.ts"],
      "@ims/containers/documents": ["./libs/containers/documents/src/index.ts"],
      "@ims/containers/home": ["./libs/containers/home/src/index.ts"],
      "@ims/containers/reports": ["./libs/containers/reports/src/index.ts"],
      "@ims/containers/stock": ["./libs/containers/stock/src/index.ts"],
      "@ims/containers/system": ["./libs/containers/system/src/index.ts"],
      "@ims/containers/warehousing": ["./libs/containers/warehousing/src/index.ts"],
      "@ims/core/http": ["./libs/core/http/src/index.ts"],
      "@ims/core/i18n": ["./libs/core/i18n/src/index.ts"],
      "@ims/core/identity": ["./libs/core/identity/src/index.ts"],
      "@ims/core/navigation": ["./libs/core/navigation/src/index.ts"],
      "@ims/core/notification": ["./libs/core/notification/src/index.ts"],
      "@ims/core/pwa": ["./libs/core/pwa/src/index.ts"],
      "@ims/core/settings": ["./libs/core/settings/src/index.ts"],
      "@ims/core/theme": ["./libs/core/theme/src/index.ts"],
      "@ims/features/administration": ["./libs/features/administration/src/index.ts"],
      "@ims/features/approvals": ["./libs/features/approvals/src/index.ts"],
      "@ims/features/audit": ["./libs/features/audit/src/index.ts"],
      "@ims/features/catalog": ["./libs/features/catalog/src/index.ts"],
      "@ims/features/documents": ["./libs/features/documents/src/index.ts"],
      "@ims/features/reports": ["./libs/features/reports/src/index.ts"],
      "@ims/features/stock": ["./libs/features/stock/src/index.ts"],
      "@ims/features/warehousing": ["./libs/features/warehousing/src/index.ts"],
      "@ims/models": ["./libs/shared/models/src/index.ts"],
      "@ims/styles": ["./libs/shared/styles/src/index.ts"],
      "@ims/ui": ["./libs/shared/ui/src/index.ts"],
      "@ims/utils": ["./libs/shared/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
