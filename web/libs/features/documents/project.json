{
  "name": "features-documents",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/features/documents/src",
  "prefix": "app",
  "tags": ["scope:features"],
  "implicitDependencies": ["shared-styles", "shared-assets"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/features/documents"],
      "options": {
        "jestConfig": "libs/features/documents/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/features/documents/src/**/*.ts",
          "libs/features/documents/src/**/*.html"
        ]
      }
    }
  }
}
