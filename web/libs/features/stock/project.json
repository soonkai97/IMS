{
  "name": "features-stock",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/features/stock/src",
  "prefix": "app",
  "tags": ["scope:features"],
  "implicitDependencies": ["shared-styles", "shared-assets"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/features/stock"],
      "options": {
        "jestConfig": "libs/features/stock/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/features/stock/src/**/*.ts", "libs/features/stock/src/**/*.html"]
      }
    }
  }
}
