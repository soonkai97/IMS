{
  "name": "ims-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end behaviour tests (Playwright) for the IMS web app. Starts nothing itself: point it at a running API and web.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:local": "node scripts/run-local.mjs",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
