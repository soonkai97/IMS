<Project>
  <PropertyGroup>
    <!-- Required for the IDE0005 (unused using) analyzer to run in dotnet format and in CI builds. Missing-XML-comment warnings are off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
