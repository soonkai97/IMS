{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "Directory": "logs"
  },
  "Jwt": {
    "Issuer": "ims",
    "Audience": "ims-clients",
    "AccessMinutes": 5
  },
  "Auth": {
    "ReturnRefreshTokenInBody": false
  },
  "Cors": {
    "Origins": "http://localhost:4200"
  },
  "RateLimit": {
    "PerMinute": 600
  },
  "AllowedHosts": "*"
}
