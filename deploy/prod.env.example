# Names only. Copy to deploy/.env.prod ON THE VM (git-ignored), fill in the values there, chmod 600, owned by the deploy user.
# Never commit a value. The GitHub deploy workflow does NOT write this file: it exists on the VM and survives deploys.

# --- which images (deploy.sh sets the two tags for you) ---
IMS_GITHUB_OWNER=                 # the GitHub user or organisation that owns the repository (lower case): ghcr.io/<owner>/ims-api and ims-web
IMS_API_TAG=                      # for example sha-1a2b3c4 (or a digest, sha256:...). deploy.sh --tag writes this
IMS_WEB_TAG=                      # the same sha- tag as the API. deploy.sh --tag writes this

# --- public address ---
DOMAIN=                           # ims.example.com: automatic TLS. Leave EMPTY for an IP-address test over plain http on port 80
ACME_EMAIL=                       # optional, contact for certificate expiry notices
IMS_CORS_ORIGINS=                 # the web origin(s), https://<DOMAIN>. The refresh-cookie CSRF check uses this list

# --- secrets (generate each one; never reuse the dev values) ---
IMS_DB_PASSWORD=                  # SQL Server sa password: 12+ characters with upper, lower, digit and symbol (the image refuses weaker ones)
IMS_JWT_KEY=                      # 32+ random characters, secret, identical on every instance. A rotation ends every session
IMS_ADMIN_PASSWORD=               # used once, to create the first administrator; change it in the app afterwards

# --- database ---
MSSQL_PID=                        # Express (free, 10 GB per database), Standard, ... : the licence the owner holds. Not Developer on a production host
IMS_MIGRATE_ON_STARTUP=false      # true for ONE start only: the first deploy (creates the schema and the first administrator). Then back to false
IMS_BACKUP_DIR=/srv/ims/backups   # host directory for .bak and .trn files; chown 10001:0 (the SQL Server user in the image)

# --- optional: resource limits (defaults suit a 2 vCPU / 4 GB VM) and the SQL image pin ---
#IMS_SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest   # pin a digest once the VM is chosen
#IMS_DB_MEM_LIMIT=2g
#IMS_DB_CPUS=2
#IMS_API_MEM_LIMIT=1g
#IMS_API_CPUS=1
#IMS_PROXY_MEM_LIMIT=256m
#IMS_PROXY_CPUS=0.5

# --- optional: backup.sh ---
#BACKUP_RETENTION_DAYS=14         # delete .bak and .trn files older than this
#BACKUP_COMPRESSION=0             # 1 adds WITH COMPRESSION (not on every edition: check the licence and the edition first)
