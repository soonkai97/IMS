# Names only. Copy to deploy/.env.prod ON THE VM (git-ignored), fill in the values there, chmod 600, owned by the deploy user.
# deploy.sh refuses to run when the file is not mode 600. Never commit a value. The GitHub deploy workflow does NOT write this file.
#
# VALUE RULES: secrets must be letters and digits only (or base64url: A-Z a-z 0-9 - _). A semicolon, a dollar sign, a hash, a quote or a space
# breaks the SQL connection string or the way this file is read. Generate them, for example:  openssl rand -base64 36 | tr -d '+/=\n' | cut -c1-32

# --- which images (deploy.sh --tag writes the two refs for you) ---
IMS_GITHUB_OWNER=                 # the GitHub user or organisation that owns the repository (lower case): ghcr.io/<owner>/ims-api and ims-web
IMS_API_REF=                      # :sha-1a2b3c4 (a tag), or @sha256:... (a digest, written by hand to pin one image). deploy.sh --tag writes this
IMS_WEB_REF=                      # the same commit as the API: :sha-1a2b3c4. deploy.sh --tag writes this

# --- public address ---
DOMAIN=                           # ims.example.com: required, automatic TLS. There is no plain-http mode (see deploy/compose.iptest.yml for a throw-away test)
IMS_CORS_ORIGINS=                 # the web origin(s), https://<DOMAIN>. The refresh-cookie CSRF check uses this list

# --- secrets (generate each one; never reuse the dev values) ---
IMS_DB_PASSWORD=                  # SQL Server sa password: 12+ characters with upper, lower and digit (the image refuses weaker ones). Used by the DBA script and the backups
IMS_JWT_KEY=                      # 32+ random characters, secret, identical on every instance. A rotation ends every session
IMS_ADMIN_PASSWORD=               # needed for the very first start only (creates the first administrator). EMPTY IT after that start

# --- the API login (gate before real data, docs/architecture/deployment.md sections 3 and 6) ---
IMS_DB_USER=                      # MANDATORY, no default (compose and deploy.sh refuse an empty value): ims_app once deploy/scripts/create-app-login.sql has been run. sa ONLY for the very first migration run, with deploy.sh --first-migration (deploy.sh refuses sa without it); never leave sa here
IMS_APP_DB_PASSWORD=              # the password of ims_app (required for any login but sa; letters and digits only)

# --- database ---
MSSQL_PID=                        # Express (free, 10 GB per database), Standard, ... : the licence the owner holds. Not Developer on a production host
IMS_MIGRATE_ON_STARTUP=false      # true for ONE start only: the first deploy (creates the schema and the first administrator; needs IMS_DB_USER=sa and deploy.sh --first-migration). Then back to false, with IMS_DB_USER=ims_app
IMS_BACKUP_DIR=/srv/ims/backups   # host directory for .bak and .trn files; chown 10001:0 and chmod 750 (the SQL Server user in the image)

# --- backups: encrypt and ship off the machine (backup.sh ship) ---
BACKUP_AGE_RECIPIENT=             # the age PUBLIC key (age1...) the backups are encrypted to. The private key lives OFF this VM
BACKUP_SHIP_COMMAND=              # a command that takes one file path and copies it off the VM, for example: rclone --config /etc/ims/rclone.conf copyto  (NO credential in this value: it shows in ps. Keep the remote credentials in a mode-600 config file; the key must be WRITE-ONLY or the bucket object-locked, so a compromised VM cannot delete off-site copies)
#BACKUP_OUTBOX=/srv/ims/outbox    # where encrypted copies wait (owned by the deploy user)
#BACKUP_RETENTION_DAYS=14         # prune deletes .bak and .trn files older than this, only if they are already shipped
#BACKUP_KEEP_FULLS=3              # prune always keeps the newest N full backups
#BACKUP_COMPRESSION=0             # 1 adds WITH COMPRESSION (not on every edition: check the licence and the edition first)

# --- backups: watching them (backup.sh check and alert; both hooks are commands ON THE VM, so no URL or token is stored in the repository) ---
#BACKUP_ALERT_COMMAND=/usr/local/bin/ims-alert   # called with ONE argument (the message) when a backup job fails or `check` finds a problem. The script holds the webhook or mail address in a mode-600 file
#BACKUP_PING_COMMAND=              # called with no argument after every successful `check` (hourly): a dead-man's-switch monitor that alerts when the pings stop. Keep any token in a mode-600 config file the command reads (a value here shows in ps)
#BACKUP_DISK_WARN_PCT=80           # `check` alerts when the disk holding the backups, the outbox or /var/lib/docker is this full
#BACKUP_UNSHIPPED_WARN_HOURS=6     # `check` alerts when a .bak or .trn file has waited this long to be shipped (prune never deletes an unshipped file, so these fill the disk)

# --- optional: resource limits (defaults suit a 2 vCPU / 4 GB VM) and the SQL image pin ---
#IMS_SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest   # pin a digest once the VM is chosen
#IMS_DB_MEM_LIMIT=2g
#IMS_DB_CPUS=2
#IMS_API_MEM_LIMIT=1g
#IMS_API_CPUS=1
#IMS_PROXY_MEM_LIMIT=256m
#IMS_PROXY_CPUS=0.5
