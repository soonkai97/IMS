<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- A version override, not a central version: a central entry would also pin it for the src projects, where EF Core Design needs the 5.0.0 line. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.9.0" />
  </ItemGroup>

  <!-- Assemblies are inspected through reflection, so the layers under test must be built and copied next to the tests. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ims.Domain\Ims.Domain.csproj" />
    <ProjectReference Include="..\..\src\Ims.Application\Ims.Application.csproj" />
    <ProjectReference Include="..\..\src\Ims.Infrastructure\Ims.Infrastructure.csproj" />
  </ItemGroup>

</Project>
