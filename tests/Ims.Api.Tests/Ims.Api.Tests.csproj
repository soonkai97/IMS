<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ims.Api\Ims.Api.csproj" />
    <ProjectReference Include="..\..\src\Ims.Infrastructure\Ims.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- One builder of tiny valid JPEG/PNG/WebP files (with and without metadata) shared with the domain tests. -->
    <Compile Include="..\Ims.Domain.Tests\Attachments\TestImages.cs" Link="Support\TestImages.cs" />
    <!-- The roles oracle (answers of the pre-roles code) and the types that read it, so a migrated database is judged by the very same files as the code (RP-2). -->
    <Compile Include="..\Ims.Domain.Tests\Identity\Oracle\OracleKeys.cs" Link="Support\Oracle\OracleKeys.cs" />
    <Compile Include="..\Ims.Domain.Tests\Identity\Oracle\OracleTable.cs" Link="Support\Oracle\OracleTable.cs" />
    <Compile Include="..\Ims.Domain.Tests\Identity\Oracle\OracleTables.cs" Link="Support\Oracle\OracleTables.cs" />
    <Compile Include="..\Ims.Domain.Tests\Identity\Oracle\NewBehaviour.cs" Link="Support\Oracle\NewBehaviour.cs" />
    <None Include="..\Ims.Domain.Tests\Identity\Oracle\*.csv" Link="Identity\Oracle\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
