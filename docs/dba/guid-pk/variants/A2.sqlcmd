:setvar KLGEN "DEFAULT (CAST(CONVERT(binary(6), DATEDIFF_BIG(MILLISECOND, '19700101', SYSUTCDATETIME())) + CRYPT_GEN_RANDOM(10) AS uniqueidentifier))"
:setvar PUBCOL ""
:setvar PUBIDX 0
